# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# Amazon Bedrock
AWS_PROFILE=
AWS_REGION=us-west-2
AWS_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_BEDROCK_SEND_TEMPERATURE=false

# Google Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.1-pro-preview

# Prefer GOOGLE_APPLICATION_CREDENTIALS pointing to a local file outside the
# repository. The base64 option is supported for managed environments.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON_B64=

